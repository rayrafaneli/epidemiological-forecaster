# .env.example
# ---------------------------------------------------------------------------
# Este arquivo é um MODELO. Copie-o para ".env" (mesma pasta) e preencha com
# os valores reais da sua máquina. O ".env" real NUNCA deve ir para o Git
# (por isso ele está listado no .gitignore) — ele pode conter senhas.
#
# Por que usar variáveis de ambiente em vez de escrever a senha no código?
# 1) Segurança: senha não fica versionada no histórico do Git.
# 2) Flexibilidade: em produção, homologação e na sua máquina local, os
#    valores podem ser diferentes sem precisar alterar uma linha de código.
# ---------------------------------------------------------------------------

# --- Banco de dados PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dengue_db
DB_USER=postgres
DB_PASSWORD=changeme

# --- INMET (Instituto Nacional de Meteorologia) ---
# API pública de tempo/clima em tempo quase real e histórico por estação.
INMET_API_BASE_URL=https://apitempo.inmet.gov.br
# A partir de quando queremos histórico (requisito do TCC: desde 2021)
INMET_START_DATE=2021-01-01
# Códigos das estações automáticas do INMET que nos interessam.
# A307 = Recife (PE). Você pode adicionar mais códigos separados por vírgula.
INMET_STATION_CODES=A301,A307

# --- IBGE ---
# UF que será usada para filtrar municípios (Recife fica em Pernambuco)
IBGE_UF=PE
IBGE_LOCALIDADES_BASE_URL=https://servicodados.ibge.gov.br/api/v1/localidades
IBGE_SIDRA_BASE_URL=https://apisidra.ibge.gov.br/values

# --- Prefeitura do Recife (integração futura - Sprint posterior) ---
# Deixamos já preparado para não precisar mudar a arquitetura depois.
RECIFE_API_BASE_URL=
RECIFE_API_TOKEN=

# --- Scheduler ---
# Horário (HH:MM, 24h) em que a rotina diária deve rodar
DAILY_JOB_TIME=03:00

# --- Logs ---
LOG_LEVEL=INFO
